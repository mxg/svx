//----------------------------------------------------------------------
// mem_txn
//----------------------------------------------------------------------
class mem_txn extends uvm_sequence_item;

  typedef enum {
		MEM_READ,
		MEM_WRITE
		} mem_txn_type_t;

  mem_txn_type_t txn_type;
  uint32_t addr;
  uint32_t data;

endclass
